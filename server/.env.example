PORT=5001
NODE_ENV=development

# Local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=volunteer_donor_management

# Optional cloud connection alternative:
# DB_DATABASE_URL=mysql://username:password@host:3306/volunteer_donor_management
# DATABASE_URL=mysql://username:password@host:3306/volunteer_donor_management

# Cloud providers may require SSL. Keep reject unauthorized enabled unless the provider requires otherwise.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=
# DB_SSL_CA_PATH=
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=replace_with_a_local_development_secret
JWT_EXPIRES_IN=7d

# Comma-separated exact origins. Include the deployed Vercel origin.
CLIENT_URL=http://localhost:5173
